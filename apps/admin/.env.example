# GraphQL API endpoint (default: /graphql)
# For Cloudflare Pages + Cloudflare Workers:
# VITE_GRAPHQL_URL=https://api.sandurfresh.com/graphql
VITE_GRAPHQL_URL=/graphql

# REST API base URL for file uploads and SSE events (default: empty / same-origin)
# For Cloudflare Pages + Cloudflare Workers:
# VITE_API_URL=https://api.sandurfresh.com
VITE_API_URL=

# Firebase Web Push VAPID public key (optional, for browser notifications)
VITE_FIREBASE_VAPID_KEY=
