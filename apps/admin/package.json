{
  "name": "@sf/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "codegen": "graphql-codegen --config codegen.ts",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "bun run build && wrangler pages deploy dist",
    "deploy": "bun run pages:deploy"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@headlessui/vue": "^1.7.23",
    "@tanstack/vue-query": "^5.90.0",
    "@vee-validate/zod": "^4.15.1",
    "firebase": "^12.17.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.3.0",
    "hono": "^4.12.31",
    "pinia": "^4.0.2",
    "vee-validate": "^4.15.1",
    "vue": "rc",
    "vue-router": "^5.2.0",
    "vuefire": "^3.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/client-preset": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "@biomejs/biome": "^2.5.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7",
    "wrangler": "^3.114.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}
