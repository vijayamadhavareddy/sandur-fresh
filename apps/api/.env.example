# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQLite database file path (created automatically)
DATABASE_PATH=./data/sandur.db

# GraphQL: set true to enable GraphiQL + introspection (dev only)
GRAPHQL_INTROSPECTION=true

# Fixed OTP accepted in non-production (phone/OTP-friendly local dev)
DEV_OTP=000000

# Admin credentials are consumed by the DB seed only when both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_COOKIE=sf_admin_session

# Product image uploads
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=5242880
