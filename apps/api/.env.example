# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQLite database file path (created automatically)
DATABASE_PATH=./data/sandur.db

# GraphQL: set true to enable GraphiQL + introspection (dev only)
GRAPHQL_INTROSPECTION=true

# Fixed OTP accepted in non-production (phone/OTP-friendly local dev)
DEV_OTP=000000

# OTP Service Configuration (Supports 2factor, dev, mock)
OTP_PROVIDER=dev
OTP_API_KEY=e41d4ff5-2be9-11eb-83d4-0200cd936042
OTP_TEMPLATE=
OTP_SENDER_ID=

# Master secret required during first-time initial admin setup
ADMIN_SETUP_SECRET=sandur-admin-setup-secret
ADMIN_SESSION_COOKIE=sf_admin_session

# Product image uploads
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=5242880

# Firebase service account for sending FCM pushes.
# Either a path to the downloaded JSON key or the JSON itself.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:8788,https://aloha.binyoga.com
