# Fastlane Environment Variables Example
# Copy this file to .env or .env.local (do not commit actual secrets to git)

# Android Play Console Deployment
ANDROID_PACKAGE_NAME=com.binyoga.smart
SUPPLY_JSON_KEY=./fastlane/play-store-key.json
ANDROID_RELEASE_TRACK=internal

# iOS / App Store Connect Deployment
IOS_APP_IDENTIFIER=com.binyoga.smart
APPLE_ID=
APPLE_TEAM_ID=
APPLE_ITC_TEAM_ID=

# App Store Connect API Key (Recommended for CI/CD)
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY= # Base64 encoded private .p8 key

# Match (iOS Code Signing, if used)
MATCH_PASSWORD=
MATCH_GIT_URL=
